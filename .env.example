# Context mode:
#   hybrid = structured SQL + BM25 page retrieval (fits free Groq ~8k TPM)
#   full   = entire tenant in the prompt (demo with OpenAI / high-limit keys)
CONTEXT_MODE=hybrid
MAX_CONTEXT_TOKENS=6500

# Default: Groq free tier (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Demo / scored run with OpenAI (full tenant):
# CONTEXT_MODE=full
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1
